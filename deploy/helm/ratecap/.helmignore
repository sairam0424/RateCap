# Patterns to ignore when building packages.
# This supports shell glob matching, relative path matching, and
# negation (prefixed with !). Only one pattern per line.
.DS_Store
# Common VCS dirs
.git/
.gitignore
.bzr/
.bzrignore
.hg/
.hgignore
.svn/
# Common backup files
*.swp
*.bak
*.tmp
*.orig
*~
# Various IDEs
.project
.idea/
*.tmproj
.vscode/
# Local agent-tooling state — gitignored globally so it never lands in a
# commit, but `helm package` doesn't consult .gitignore, so without these
# lines it silently bundles whatever local tooling cruft happens to be
# sitting in this directory (verified empirically: .swarm/agentdb-memory.db
# and ruvector.db, both multi-MB, ended up inside a packaged .tgz).
.claude-flow/
.swarm/
ruvector.db
